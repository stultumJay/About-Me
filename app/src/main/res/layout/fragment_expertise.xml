<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="Expertise"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠 Core Skills"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/ateneo_blue_vibrant"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Frontend: HTML5, CSS3, JS ES6+, Kotlin"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Backend: PHP, MySQL, Java, Python, basic JSP"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Tools: Git/GitHub, VS Code, Oracle VirtualBox"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\nSoft Skills"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ateneo_blue_vibrant"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Problem-solving under deadlines"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Clear technical documentation"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\nLanguages"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ateneo_blue_vibrant"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Cebuano (expert)"
            android:textColor="@color/white"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Filipino (expert)"
            android:textColor="@color/white"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• English (expert)"
            android:textColor="@color/white"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• French (basic)"
            android:textColor="@color/white"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Japanese (basic)"
            android:textColor="@color/white"/>

    </LinearLayout>
</ScrollView>